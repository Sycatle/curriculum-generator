# Template for the production env file. After filling in real values, save as
# `secrets/.env.production` and encrypt with: sops -e -i secrets/.env.production
# Then commit the encrypted file. Decrypt at deploy time with `sops -d`.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://cv.example.com

DATABASE_URL=postgres://cv:CHANGE_ME@postgres:5432/cv
DATABASE_POOL_MAX=10

BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
BETTER_AUTH_URL=https://cv.example.com

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CV Generator <noreply@cv.example.com>"

# --- AI (Anthropic) ---
# Required for OCR import + AI chat assistant.
ANTHROPIC_API_KEY=
