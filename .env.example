# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database ---
# Local dev (matches docker-compose.dev.yml)
DATABASE_URL=postgres://cv:cv@localhost:5435/cv

# --- Auth (Better-Auth) ---
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_me_with_openssl_rand_hex_32
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth (https://github.com/settings/developers)
# Callback: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Magic link email (SMTP). In dev, leave empty to log links to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CV Generator <noreply@example.com>"

# --- Jobs ---
# Shared secret used by the `cron` sidecar to call /api/cron/refresh-sources.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# France Travail (optional connector). https://francetravail.io
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- AI (Anthropic) ---
# Required for CV OCR import and the AI chat assistant.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
